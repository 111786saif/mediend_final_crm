# ============================================================
# Mediend CRM - Nginx config for IP-only access (no domain)
# ============================================================
#
# 1. Upstream (same as domain deploy):
#    echo 'upstream mediend_app { server 127.0.0.1:3000; }' > /etc/nginx/conf.d/mediend-upstream.conf
#
# 2. Replace YOUR_SERVER_IP, then install:
#    sed "s/YOUR_SERVER_IP/187.127.140.122/" nginx.conf.ip.example > /etc/nginx/sites-available/mediend-ip
#    ln -sf /etc/nginx/sites-available/mediend-ip /etc/nginx/sites-enabled/mediend-ip
#    rm -f /etc/nginx/sites-enabled/default
#    nginx -t && systemctl reload nginx
#
# 3. In /root/mediend.workspace/.env set:
#    NEXT_PUBLIC_APP_URL=http://YOUR_SERVER_IP
#    Then rebuild: docker compose build --no-parallel app && docker compose up -d app
# ============================================================

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name YOUR_SERVER_IP _;

    client_max_body_size 25m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_connect_timeout 10s;

    location / {
        proxy_pass http://mediend_app;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
