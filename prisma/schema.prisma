generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                   String                                   @id @default(cuid())
  email                                String                                   @unique
  passwordHash                         String
  name                                 String
  role                                 UserRole
  createdAt                            DateTime                                 @default(now())
  updatedAt                            DateTime                                 @updatedAt
  address                              String?
  phoneNumber                          String?
  profilePicture                       String?
  gender                               String?
  emergencyContactName                 String?
  emergencyContactPhone                String?
  currentAddress                       Json?
  permanentAddress                     Json?
  admissionsInitiated                  AdmissionRecord[]                        @relation("AdmissionInitiator")
  aiConversations                      AiConversation[]
  aiMessages                           AiMessage[]
  aiToolCalls                          AiToolCall[]
  bulkLeadReassignmentRuns             BulkLeadReassignmentRun[]                @relation("BulkLeadReassignmentActor")
  leadCallNotes                        CallNote[]                               @relation("LeadCallNoteAuthor")
  campaignCplsCreated                  CampaignCPL[]                            @relation("CampaignCPLCreator")
  caseChatMessagesSent                 CaseChatMessage[]                        @relation("CaseChatSender")
  caseStageChanges                     CaseStageHistory[]                       @relation("CaseStageChanger")
  chatReadReceipts                     ChatReadReceipt[]                        @relation("ChatReadUser")
  complianceCallsHandled               ComplianceCall[]                         @relation("ComplianceCallCaller")
  crmActivityLogs                      CrmActivityLog[]                         @relation("CrmActivityActor")
  crmAssignmentRulesCreated            CrmAssignmentRule[]                      @relation("CrmAssignmentRuleCreator")
  crmAssignmentRulesUpdated            CrmAssignmentRule[]                      @relation("CrmAssignmentRuleUpdater")
  campaignTeamLeadAssignments          CrmCampaignTeamLeadAssignment[]          @relation("CampaignTeamLeadUser")
  cumulativeReportManualEntriesUpdated CumulativeReportManualEntry[]            @relation("CumulativeReportManualEntryUpdatedBy")
  dailyCampaignSpends                  DailyCampaignSpend[]                     @relation("DailyCampaignSpendCreator")
  departmentHeadOf                     Department[]                             @relation("DepartmentHead")
  departmentRevenuesCreated            DepartmentRevenue[]                      @relation("DepartmentRevenueCreator")
  dischargeSheetsCreated               DischargeSheet[]                         @relation("DischargeSheetCreator")
  dischargeSheetsFinalized             DischargeSheet[]                         @relation("DischargeSheetFinalizer")
  dischargeSheetsMarked                DischargeSheet[]                         @relation("DischargeSheetMarker")
  doctorCabRequestsVendorAssigned      DoctorCabRequest[]                       @relation("DoctorCabVendorAssigner")
  doctorCabRequestsReviewed            DoctorCabRequest[]                       @relation("DoctorCabReviewer")
  doctorLeaveRequestsReviewed          DoctorLeaveRequest[]                     @relation("DoctorLeaveReviewer")
  doctorPayoffRequestsSubmitted        DoctorPayoffRequest[]                    @relation("DoctorPayoffRequestedBy")
  doctorPayoffRequestsReviewed         DoctorPayoffRequest[]                    @relation("DoctorPayoffReviewedBy")
  doctorPayoffRequestActivities        DoctorPayoffRequestActivity[]            @relation("DoctorPayoffActivityActor")
  fnfCompletedForEmployees             Employee[]                               @relation("FnFCompletedBy")
  onboardingApprovals                  Employee[]                               @relation("OnboardingApprover")
  employee                             Employee?
  masterSeatingCostsCreated            EmployeeMasterSeatingCost[]              @relation("MasterSeatingCostCreatedBy")
  masterSeatingCostsUpdated            EmployeeMasterSeatingCost[]              @relation("MasterSeatingCostUpdatedBy")
  employeeIncentivesCreated            EmployeeMonthlyIncentive[]               @relation("EmployeeIncentiveCreatedBy")
  employeeIncentivesUpdated            EmployeeMonthlyIncentive[]               @relation("EmployeeIncentiveUpdatedBy")
  seatingMiscCostsCreated              EmployeeMonthlySeatingMiscCost[]         @relation("SeatingMiscCostCreatedBy")
  seatingMiscCostsUpdated              EmployeeMonthlySeatingMiscCost[]         @relation("SeatingMiscCostUpdatedBy")
  seatingMiscCostHistory               EmployeeMonthlySeatingMiscCostHistory[]  @relation("SeatingMiscCostHistoryBy")
  salesTeamSalaryOverridesUpdated      EmployeeSalesTeamSalaryOverride[]        @relation("SalesTeamSalaryOverrideUpdatedBy")
  salesTeamSalaryOverrideHistory       EmployeeSalesTeamSalaryOverrideHistory[] @relation("SalesTeamSalaryOverrideHistoryBy")
  itFreelancersCreated                 ITFreelancer[]                           @relation("ITFreelancerCreator")
  itProjectsCreated                    ITProject[]                              @relation("ITProjectCreator")
  itProjectBookingsCreated             ITProjectBooking[]                       @relation("ITProjectBookingCreator")
  insuranceCases                       InsuranceCase[]
  insuranceInitiateFormsCreated        InsuranceInitiateForm[]                  @relation("InsuranceInitiateFormCreator")
  queriesAnswered                      InsuranceQuery[]                         @relation("QueryAnswerer")
  queriesRaised                        InsuranceQuery[]                         @relation("QueryRaiser")
  invoiceRequestsSubmitted             InvoiceRequest[]                         @relation("InvoiceRequestRequestedBy")
  invoiceRequestsReviewed              InvoiceRequest[]                         @relation("InvoiceRequestReviewedBy")
  invoiceRequestActivities             InvoiceRequestActivity[]                 @relation("InvoiceRequestActivityActor")
  issuesCreated                        IssueTransaction[]                       @relation("IssueCreator")
  issuesReceived                       IssueTransaction[]                       @relation("IssueRecipient")
  kypSubmissions                       KYPSubmission[]                          @relation("KYPSubmitter")
  knowledgeDocumentsUploaded           KnowledgeDocument[]                      @relation("KnowledgeDocumentUploader")
  knowledgeDocumentUsers               KnowledgeDocumentUser[]
  assignedLeads                        Lead[]                                   @relation("LeadBD")
  createdLeads                         Lead[]                                   @relation("LeadCreator")
  updatedLeads                         Lead[]                                   @relation("LeadUpdater")
  leadQrCallAuditLogs                  LeadQrCallAuditLog[]                     @relation("LeadQrCallAuditActor")
  leadRemarkEntriesAuthored            LeadRemarkEntry[]                        @relation("LeadRemarkEntryAuthor")
  leadStageEvents                      LeadStageEvent[]
  leaveBalanceEditRequestsRequested    LeaveBalanceEditRequest[]                @relation("LeaveBalanceEditRequestedBy")
  leaveBalanceEditRequestsReviewed     LeaveBalanceEditRequest[]                @relation("LeaveBalanceEditReviewedBy")
  approvedLeaves                       LeaveRequest[]                           @relation("LeaveApprover")
  ledgerAuditLogs                      LedgerAuditLog[]                         @relation("LedgerAuditPerformer")
  approvedLedgerEntries                LedgerEntry[]                            @relation("LedgerApprover")
  createdLedgerEntries                 LedgerEntry[]                            @relation("LedgerCreator")
  deleteApprovedLedgerEntries          LedgerEntry[]                            @relation("LedgerDeleteApprover")
  deleteRequestedLedgerEntries         LedgerEntry[]                            @relation("LedgerDeleteRequester")
  deletedLedgerEntries                 LedgerEntry[]                            @relation("LedgerDeleter")
  editApprovedLedgerEntries            LedgerEntry[]                            @relation("LedgerEditApprover")
  editRequestedLedgerEntries           LedgerEntry[]                            @relation("LedgerEditRequester")
  mdApprovalsFinanceAcked              MDApprovalRequest[]                      @relation("MDApprovalFinanceAck")
  mdApprovalRequests                   MDApprovalRequest[]                      @relation("MDApprovalRequester")
  mdApprovalsResponded                 MDApprovalRequest[]                      @relation("MDApprovalResponder")
  mdTaskTeamsOwned                     MDTaskTeam[]                             @relation("MDTaskTeamOwner")
  mdWatchlistOwned                     MDWatchlistEmployee[]                    @relation("MDWatchlistOwner")
  meetsCreated                         Meet[]                                   @relation("MeetsCreated")
  meetParticipations                   MeetParticipant[]
  noticesCreated                       Notice[]                                 @relation("NoticeCreator")
  noticeRecipients                     NoticeRecipient[]
  notifications                        Notification[]
  outstandingCasesHandled              OutstandingCase[]                        @relation("OutstandingHandler")
  plRecords                            PLRecord[]
  paymentInstallmentsRecorded          PaymentInstallment[]                     @relation("InstallmentRecorder")
  paymentInstallmentsVerified          PaymentInstallment[]                     @relation("InstallmentVerifier")
  permissionsGranted                   PermissionAssignment[]                   @relation("GrantedBy")
  permissionSubjects                   PermissionAssignment[]                   @relation("PermissionSubject")
  pnlCategoriesCreated                 PnLCategory[]                            @relation("PnLCategoryCreator")
  pnlEntriesCreated                    PnLEntry[]                               @relation("PnLEntryCreator")
  pdfsCreated                          PreAuthPDF[]                             @relation("PDFCreator")
  preAuthHandled                       PreAuthorization[]                       @relation("PreAuthHandler")
  preAuthHeld                          PreAuthorization[]                       @relation("PreAuthHolder")
  preAuthsRaised                       PreAuthorization[]                       @relation("PreAuthRaiser")
  purchasesCreated                     PurchaseTransaction[]                    @relation("PurchaseCreator")
  pushSubscriptions                    PushSubscription[]
  createdSalesEntries                  SalesEntry[]                             @relation("SalesCreator")
  salesTeamBulkCostsCreated            SalesTeamBulkCostEntry[]                 @relation("SalesTeamBulkCostCreatedBy")
  salesTeamBulkCostsUpdated            SalesTeamBulkCostEntry[]                 @relation("SalesTeamBulkCostUpdatedBy")
  salesTeamBulkCostHistory             SalesTeamBulkCostEntryHistory[]          @relation("SalesTeamBulkCostHistoryBy")
  salesTeamCostEntriesAdded            SalesTeamCostEntry[]                     @relation("SalesTeamCostEntryAddedBy")
  stockMovementsCreated                StockMovement[]                          @relation("StockMovementCreator")
  createdTargets                       Target[]                                 @relation("TargetCreator")
  targetPnlEntriesCreated              TargetPnLEntry[]                         @relation("TargetPnLEntryCreator")
  tasksAssigned                        Task[]                                   @relation("TaskAssignee")
  tasksCompleted                       Task[]                                   @relation("TaskCompletedBy")
  tasksCreated                         Task[]                                   @relation("TaskCreator")
  taskActivityLogs                     TaskActivityLog[]
  taskComments                         TaskComment[]
  taskApprovalsRequested               TaskDueDateApproval[]
  taskProjectsCreated                  TaskProject[]                            @relation("TaskProjectCreator")
  taskRatingsReceived                  TaskRating[]                             @relation("TaskRatingsReceived")
  taskRatingsGiven                     TaskRating[]                             @relation("TaskRatingsGiven")
  createdTierDefinitions               TierDefinition[]                         @relation("TierDefinitionCreator")
  crmPermissionsGranted                UserCrmPermission[]                      @relation("CrmPermissionGranter")
  crmPermissions                       UserCrmPermission[]
  featurePermissionsGranted            UserFeaturePermission[]                  @relation("PermissionGranter")
  featurePermissions                   UserFeaturePermission[]
  statuses                             UserStatus[]
  userTaskSeen                         UserTaskSeen[]
  warningsReceived                     Warning[]                                @relation("EmployeeWarnings")
  warningsIssued                       Warning[]                                @relation("IssuedWarnings")
  workLogs                             WorkLog[]
  workflowResetsPerformed              WorkflowResetLog[]                       @relation("WorkflowResetPerformer")

  @@index([email])
  @@index([role])
}

model UserStatus {
  id        String         @id @default(cuid())
  userId    String
  kind      UserStatusKind
  label     String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
  @@index([startsAt])
}

model Lead {
  id                       String                     @id @default(cuid())
  leadRef                  String                     @unique
  patientName              String
  age                      Int
  dateOfBirth              DateTime?
  sex                      String
  phoneNumber              String
  alternateNumber          String?
  attendantName            String?
  bdId                     String
  status                   String
  pipelineStage            PipelineStage              @default(SALES)
  caseStage                CaseStage                  @default(NEW_LEAD)
  circle                   String
  category                 String?
  treatment                String?
  anesthesia               String?
  quantityGrade            String?
  surgeonName              String?
  surgeonType              String?
  hospitalName             String
  flowType                 FlowType                   @default(INSURANCE)
  modeOfPayment            String?
  discount                 Float                      @default(0)
  copay                    Float                      @default(0)
  deduction                Float                      @default(0)
  settledTotal             Float                      @default(0)
  billAmount               Float                      @default(0)
  insuranceName            String?
  tpa                      String?
  sumInsured               Float?
  roomRent                 Float?
  icu                      Float?
  capping                  Float?
  arrivalDate              DateTime?
  arrivalTime              String?
  surgeryDate              DateTime?
  operationTime            String?
  implantType              String?
  implantAmount            Float                      @default(0)
  instrument               String?
  consumables              String?
  createdById              String
  createdDate              DateTime                   @default(now())
  updatedById              String
  updatedDate              DateTime                   @updatedAt
  remarks                  String?
  source                   String?
  campaignName             String?
  bdeName                  String?
  conversionDate           DateTime?
  mediendProfit            Float                      @default(0)
  hospitalShare            Float                      @default(0)
  doctorShare              Float                      @default(0)
  othersShare              Float                      @default(0)
  netProfit                Float                      @default(0)
  ticketSize               Float                      @default(0)
  collectedByMediend       Float                      @default(0)
  collectedByHospital      Float                      @default(0)
  month                    String?
  leadEntryDate            DateTime?
  patientEmail             String?
  whatsapp                 String?
  address                  String?
  docUpload                String?
  diseaseDetails           String?
  followUpDate             DateTime?
  subStatus                Int?
  opdHospital              String?
  opdDrName                String?
  opdContactNo             String?
  opdCharges               Int                        @default(0)
  opdScheduleDate          DateTime?
  opdMeeting               Int?
  ipdAdmissionDate         DateTime?
  ipdHospital              String?
  ipdDrName                String?
  ipdContactNo             String?
  ipdTotalPayment          Int                        @default(0)
  ipdDetails               String?
  paymentDetails           Int?
  attendantContactNo       String?
  waFormat                 String?
  leadSource               Int?
  whatsappMessage          String?
  notification             Boolean                    @default(false)
  emailSent                Boolean                    @default(false)
  smsSent                  Boolean                    @default(false)
  whatsappSent             Boolean                    @default(false)
  website                  String?
  description              String?
  refId                    String?
  duplCount                Int                        @default(0)
  aes                      Boolean                    @default(false)
  profession               String?
  qr                       String?
  removeRemarks            Boolean                    @default(false)
  adId                     String?
  campaignId               String?
  formId                   String?
  teamLeadId               Int?
  remarksId                String?
  lostReason               String?
  lostAt                   DateTime?
  assignedDate             DateTime?
  atsAmount                Float?
  atsStatus                ATSStatus?                 @default(NO_ATS)
  treatmentMasterId        String?
  remarksClearedAt         DateTime?
  isOldCrmLead             Boolean                    @default(false)
  opdDiagnosis             String?
  opdFollowUpReasonCode    String?
  opdImplantRequired       Boolean?
  opdReasonNoSurgeryCode   String?
  opdSurgeryAdvised        String?
  opdSurgeryRemarkCode     String?
  admissionRecord          AdmissionRecord?
  callNotes                CallNote[]
  caseChatMessages         CaseChatMessage[]
  caseStageHistory         CaseStageHistory[]
  chatReadReceipts         ChatReadReceipt[]          @relation("ChatReadLead")
  complianceCall           ComplianceCall?
  crmAssignmentPreviewLogs CrmAssignmentPreviewLog[]
  dischargeSheet           DischargeSheet?
  doctorPayoffRequests     DoctorPayoffRequest[]
  insuranceCase            InsuranceCase?
  insuranceInitiateForm    InsuranceInitiateForm?
  invoiceRequests          InvoiceRequest[]
  kypSubmission            KYPSubmission?
  bd                       User                       @relation("LeadBD", fields: [bdId], references: [id])
  createdBy                User                       @relation("LeadCreator", fields: [createdById], references: [id])
  opdFollowUpReason        FollowUpReasonMaster?      @relation("LeadOpdFollowUpReason", fields: [opdFollowUpReasonCode], references: [code])
  opdReasonNoSurgery       ReasonNoSurgeryMaster?     @relation("LeadOpdReasonNoSurgery", fields: [opdReasonNoSurgeryCode], references: [code])
  opdSurgeryRemark         SurgeryRemarkMaster?       @relation("LeadOpdSurgeryRemark", fields: [opdSurgeryRemarkCode], references: [code])
  treatmentMaster          TreatmentMaster?           @relation(fields: [treatmentMasterId], references: [id])
  updatedBy                User                       @relation("LeadUpdater", fields: [updatedById], references: [id])
  opdAppointments          LeadOpdAppointment[]
  opdPrescriptionImages    LeadOpdPrescriptionImage[]
  qrCallAuditLogs          LeadQrCallAuditLog[]
  leadRemarkEntries        LeadRemarkEntry[]
  stageEvents              LeadStageEvent[]
  outstandingCase          OutstandingCase?
  plRecord                 PLRecord?
  paymentInstallments      PaymentInstallment[]
  workflowResetLogs        WorkflowResetLog[]

  @@index([bdId])
  @@index([status])
  @@index([pipelineStage])
  @@index([caseStage])
  @@index([circle])
  @@index([hospitalName])
  @@index([treatment])
  @@index([source])
  @@index([createdDate])
  @@index([conversionDate])
  @@index([surgeryDate])
  @@index([leadEntryDate])
  @@index([assignedDate])
  @@index([followUpDate])
  @@index([opdSurgeryRemarkCode])
  @@index([opdReasonNoSurgeryCode])
  @@index([opdFollowUpReasonCode])
}

model LeadOpdPrescriptionImage {
  id         String   @id @default(cuid())
  leadId     String
  fileName   String
  fileUrl    String
  storageKey String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, sortOrder])
}

model CallNote {
  id          String   @id @default(cuid())
  leadId      String
  content     String
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("LeadCallNoteAuthor", fields: [createdById], references: [id])
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model LeadRemarkEntry {
  id          String   @id @default(cuid())
  leadId      String
  content     String
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("LeadRemarkEntryAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([createdById, createdAt])
}

model LeadQrCallAuditLog {
  id          String   @id @default(cuid())
  leadId      String
  userId      String
  action      String
  phoneNumber String
  source      String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User     @relation("LeadQrCallAuditActor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model LeadStageEvent {
  id          String        @id @default(cuid())
  leadId      String
  fromStage   PipelineStage
  toStage     PipelineStage
  changedById String
  changedAt   DateTime      @default(now())
  note        String?
  changedBy   User          @relation(fields: [changedById], references: [id])
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([changedAt])
}

model Target {
  id                String       @id @default(cuid())
  targetType        TargetType
  targetForId       String
  periodType        PeriodType
  periodStartDate   DateTime
  periodEndDate     DateTime
  metric            TargetMetric
  targetValue       Float
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  /// For HR head count: [{ departmentId, addCount }, ...]
  departmentTargets Json?
  bonusRules        BonusRule[]
  createdBy         User         @relation("TargetCreator", fields: [createdById], references: [id])

  @@index([targetType, targetForId])
  @@index([periodStartDate, periodEndDate])
}

model BonusRule {
  id              String        @id @default(cuid())
  targetId        String
  ruleType        BonusRuleType
  thresholdValue  Float
  bonusAmount     Float?
  bonusPercentage Float?
  capAmount       Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  target          Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

model TierDefinition {
  id             String       @id @default(cuid())
  name           String
  metric         TargetMetric
  thresholdValue Float
  order          Int
  rewardAmount   Float?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation("TierDefinitionCreator", fields: [createdById], references: [id])

  @@index([metric, order])
}

model InsuranceCase {
  id             String              @id @default(cuid())
  leadId         String              @unique
  caseStatus     InsuranceCaseStatus @default(IN_PROGRESS)
  approvalAmount Float?
  tpaRemarks     String?
  submittedAt    DateTime            @default(now())
  approvedAt     DateTime?
  handledById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  handledBy      User?               @relation(fields: [handledById], references: [id])
  lead           Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([caseStatus])
  @@index([submittedAt])
}

model PLRecord {
  id                    String              @id @default(cuid())
  leadId                String              @unique
  month                 DateTime?
  surgeryDate           DateTime?
  status                String?
  paymentType           String?
  approvedOrCash        String?
  paymentCollectedAt    String?
  managerRole           String?
  managerName           String?
  bdmName               String?
  patientName           String?
  patientPhone          String?
  doctorName            String?
  hospitalName          String?
  category              String?
  treatment             String?
  circle                String?
  leadSource            String?
  totalAmount           Float               @default(0)
  billAmount            Float               @default(0)
  cashPaidByPatient     Float               @default(0)
  cashOrDedPaid         Float               @default(0)
  referralAmount        Float               @default(0)
  cabCharges            Float               @default(0)
  implantCost           Float               @default(0)
  dcCharges             Float               @default(0)
  doctorCharges         Float               @default(0)
  hospitalSharePct      Float?
  hospitalShareAmount   Float               @default(0)
  mediendSharePct       Float?
  mediendShareAmount    Float               @default(0)
  mediendNetProfit      Float               @default(0)
  finalProfit           Float               @default(0)
  hospitalPayoutStatus  String?
  doctorPayoutStatus    String?
  mediendInvoiceStatus  String?
  hospitalAmountPending Float               @default(0)
  doctorAmountPending   Float               @default(0)
  remarks               String?
  closedAt              DateTime?
  handledById           String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  admissionDate         DateTime?
  implantPaidBy         PaidByParty?
  instrumentsCost       Float               @default(0)
  instrumentsPaidBy     PaidByParty?
  costBreakdownRemarks  String?
  doctorRemarks         String?
  outstandingStatus     PLOutstandingStatus @default(NEW)
  actualImplantCost     Float               @default(0)
  actualInstrumentCost  Float               @default(0)
  hospitalRecoverAmount Float               @default(0)
  mediendProfit         Float               @default(0)
  dischargeSheet        DischargeSheet?     @relation("DischargeSheetPLRecord")
  handledBy             User?               @relation(fields: [handledById], references: [id])
  lead                  Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([closedAt])
  @@index([month])
  @@index([surgeryDate])
  @@index([status])
}

model InvoiceRequest {
  id               String                   @id @default(cuid())
  leadId           String
  status           InvoiceRequestStatus     @default(PENDING)
  requestRemarks   String?
  invoiceNumber    String?
  invoiceAmount    Float?
  invoicePdfUrl    String?
  invoicePdfName   String?
  financeRemarks   String?
  rejectionRemarks String?
  requestedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  lead             Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requestedBy      User                     @relation("InvoiceRequestRequestedBy", fields: [requestedById], references: [id])
  reviewedBy       User?                    @relation("InvoiceRequestReviewedBy", fields: [reviewedById], references: [id])
  activityLogs     InvoiceRequestActivity[]

  @@index([leadId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
}

model InvoiceRequestActivity {
  id        String         @id @default(cuid())
  requestId String
  action    String
  message   String
  remarks   String?
  actorId   String
  createdAt DateTime       @default(now())
  actor     User           @relation("InvoiceRequestActivityActor", fields: [actorId], references: [id])
  request   InvoiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
  @@index([actorId])
}

model DoctorPayoffRequest {
  id                  String                        @id @default(cuid())
  doctorName          String
  hospitalName        String?
  leadId              String?
  /// string[] of related lead IDs (batch requests)
  leadIds             Json?
  requestAmount       Float
  requestRemarks      String?
  financeRemarks      String?
  rejectionRemarks    String?
  /// [{ name, url, type }]
  attachments         Json?
  status              DoctorPayoffRequestStatus     @default(PENDING)
  requestedById       String
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  /// Finance verification document uploaded on approval
  verificationDocUrl  String?
  verificationDocName String?
  lead                Lead?                         @relation(fields: [leadId], references: [id])
  requestedBy         User                          @relation("DoctorPayoffRequestedBy", fields: [requestedById], references: [id])
  reviewedBy          User?                         @relation("DoctorPayoffReviewedBy", fields: [reviewedById], references: [id])
  activityLogs        DoctorPayoffRequestActivity[]

  @@index([doctorName])
  @@index([hospitalName])
  @@index([leadId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
}

model DoctorPayoffRequestActivity {
  id        String              @id @default(cuid())
  requestId String
  action    String
  message   String
  remarks   String?
  actorId   String
  createdAt DateTime            @default(now())
  actor     User                @relation("DoctorPayoffActivityActor", fields: [actorId], references: [id])
  request   DoctorPayoffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
  @@index([actorId])
}

model IncomingLead {
  id                         String    @id @default(cuid())
  source                     String?
  payload                    Json
  status                     String    @default("PENDING")
  receivedAt                 DateTime  @default(now())
  errorMessage               String?
  externalCampaignId         String?
  normalizedPhone            String?
  processedAt                DateTime?
  processedLeadId            String?
