model AttendanceNormalization {
  id                  String              @id @default(cuid())
  employeeId          String
  date                DateTime
  type                NormalizationType
  requestedById       String
  approvedById        String?
  status              NormalizationStatus @default(APPROVED)
  reason              String?
  /// *
  ///    * For SELF type: 1, 2, or 3 hours of monthly allowance used. MANAGER/EMPLOYEE_REQUEST: null.
  hoursUsed           Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  managerApprovedAt   DateTime?
  managerApprovedById String?
  /// *
  ///    * FULL_DAY or HALF_DAY - set by manager when approving.
  normalizeAs         String?
  /// *
  ///    * Filled when HR rejects (min length enforced in API).
  hrRejectionReason   String?
