  employee            Employee            @relation("NormalizationSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  managerApprovedBy   Employee?           @relation("NormalizationManagerApprover", fields: [managerApprovedById], references: [id])
  requestedBy         Employee            @relation("NormalizationRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([approvedById])
  @@index([requestedById])
  @@index([managerApprovedById])
}

