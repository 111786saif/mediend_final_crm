# Minimal Node-based migrate image for when Bun image cannot be pulled (e.g. Docker Hub timeout).
# Usage: docker compose --profile tools run --rm --build migrate-deploy-node
FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app
COPY prisma.config.ts ./
COPY prisma ./prisma/

# Install Prisma CLI only — do not copy package.json (npm would resolve the full app tree).
RUN npm install -g prisma@7.5.0

CMD ["prisma", "migrate", "deploy"]
