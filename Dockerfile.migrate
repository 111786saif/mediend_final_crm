# Minimal Node-based migrate image for when Bun image cannot be pulled (e.g. Docker Hub timeout).
# Usage: docker compose --profile tools run --rm --build migrate-deploy-node
FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app
COPY prisma.config.ts ./
COPY prisma ./prisma/

# Prisma CLI + deps required by prisma.config.ts (dotenv, prisma/config).
# Do not copy the app package.json — npm would resolve the full React tree.
RUN npm install -g prisma@7.5.0 \
  && npm install dotenv@16 prisma@7.5.0 --no-save --legacy-peer-deps

CMD ["prisma", "migrate", "deploy"]
